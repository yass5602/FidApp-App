# ── Serveur ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de données ────────────────────────────────────────
# MongoDB Atlas → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fidapp?retryWrites=true&w=majority

# ── JWT Auth (sessions utilisateurs) ─────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-de-64-caracteres-minimum
JWT_EXPIRES_IN=7d

# ── JWT QR (tokens dynamiques 60s) ───────────────────────
QR_JWT_SECRET=un-autre-secret-different-du-precedent-pour-les-qr-codes
QR_JWT_EXPIRES_IN=60s

# ── CORS ──────────────────────────────────────────────────
# Séparer par virgule, sans espace
#ALLOWED_ORIGINS=http://localhost:5173,https://fidapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.185:5173,http://192.168.1.170:5173

# ── (Optionnel) Notifications push ───────────────────────
# FCM_SERVER_KEY=votre-cle-firebase-cloud-messaging
